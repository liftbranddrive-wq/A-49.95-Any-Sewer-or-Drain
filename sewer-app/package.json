{
  "name": "sewer-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "eas-build-pre-install": "if [ -n \"$FIREBASE_API_KEY\" ]; then sed -i 's/__FIREBASE_API_KEY__/'\"$FIREBASE_API_KEY\"'/g' google-services.json; fi",
    "eas-build-post-install": "node -e \"const fs = require('fs'); let file = 'android/app/build.gradle'; if (fs.existsSync(file)) { let lines = fs.readFileSync(file, 'utf8').split('\\n'); lines = lines.map(line => line.includes('projectRoot') && line.includes('def') ? 'def projectRoot = \\\"/home/expo/workingdir/build/sewer-app\\\"' : line); fs.writeFileSync(file, lines.join('\\n')); console.log('Successfully enforced absolute projectRoot line'); }\""
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.15",
    "@react-navigation/native": "^7.3.15",
    "buffer": "^6.0.3",
    "expo": "^57.0.17",
    "expo-auth-session": "^57.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "^57.0.15",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "^57.0.16",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-notifications": "^57.0.15",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "lucide-react-native": "^1.31.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "private": true
}