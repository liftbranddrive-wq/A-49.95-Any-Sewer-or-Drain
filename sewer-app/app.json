        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "cfb6f963-bd93-45f5-97b9-8ed91c5c0d70"
      }
    },
    "owner": ""
  }
